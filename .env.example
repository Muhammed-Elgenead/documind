# Copy to .env and fill in. Never commit .env.

# Postgres (used by the db service and to build DATABASE_URL in docker-compose)
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind

# Backend database URL when running the backend outside Docker (uv run ...).
# Hosted URLs (Neon etc.) can be pasted as is: postgresql://...?sslmode=require works.
DATABASE_URL=postgresql+asyncpg://documind:change-me@localhost:5432/documind

# Auth: secret for signing login tokens. Generate with `openssl rand -hex 32`.
# Empty = random per start (fine for dev, but everyone is signed out on restart).
JWT_SECRET=
# Token lifetime in minutes (default 7 days)
JWT_EXPIRE_MINUTES=10080
# Rate limits, "count/period" rules joined by ";" (second|minute|hour|day). Empty = off.
# /chat is per user; register/login per client IP.
CHAT_RATE_LIMIT=10/minute;200/day
AUTH_RATE_LIMIT=10/minute

# LLM
# Provider: "gemini" (Google) or "anthropic" (Claude)
LLM_PROVIDER=gemini
# Empty = provider default (gemini-3.8-flash / claude-opus-5-5)
LLM_MODEL=gemini-3.8-flash
LLM_MAX_TOKENS=16000
# Reasoning depth, empty = model default.
# Gemini thinking_level: minimal | low | medium | high | xhigh
# Anthropic effort: low | medium | high | xhigh | max
LLM_EFFORT=
# Key for the provider you use (Gemini: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=
# Anthropic only: server-side refusal fallback (beta)
LLM_FALLBACKS=true

# Retrieval / chat
# vector | hybrid (vector + full-text, Reciprocal Rank Fusion) | hybrid_rerank (+ cross-encoder)
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_TOP_K=8
# Candidates per list (vector, full-text), and how many get re-ranked
RETRIEVAL_CANDIDATES=20
RRF_K=60
# Relevance gates: below these the answer is "not found" and the LLM is not called. 0 = off.
# Calibrated for the default models; re-check them if you change models.
RETRIEVAL_MIN_SIMILARITY=0.78
RERANK_MIN_SCORE=0.0001
# Re-ranker: "fastembed" (local cross-encoder, ~120 MB, no key) or "overlap" (tests only)
RERANKER_PROVIDER=fastembed
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
CHAT_HISTORY_MESSAGES=6

# JSON list of allowed browser origins (in production: your Vercel URL)
CORS_ORIGINS=["http://localhost:5173"]
# Optional regex for extra origins, e.g. Vercel previews: https://documind-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=

# Uploads (paths are relative to backend/ when running locally; Docker overrides them)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

# Chunking (estimated tokens, ~4 chars/token)
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Embeddings: "fastembed" (local model, no key) or "hash" (offline tests/dev only).
# Changing to a model with a different vector size requires a migration.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2
EMBEDDING_CACHE_DIR=data/models
# Texts per model batch. Peak memory grows with it (both models: ~455 MB at 1,
# ~760 MB at 4, ~1.6 GB at 16). Lower on small servers.
EMBEDDING_BATCH_SIZE=4
RERANK_BATCH_SIZE=4

# Frontend (production build only, e.g. on Vercel): the backend's public URL.
# In development leave it unset; the Vite dev server proxies /api to the backend.
# VITE_API_URL=https://your-api.up.railway.app

# Evals (evals/run_evals.py); all optional
# Database to ingest the sample PDFs into and evaluate against (default: DATABASE_URL)
EVAL_DATABASE_URL=
# Model for the LLM judge (default: LLM_MODEL)
EVAL_JUDGE_MODEL=
# USD per 1M tokens, for models without a built-in price (Gemini 3.6-3.8 Flash are built in)
EVAL_PRICE_INPUT_PER_MTOK=
EVAL_PRICE_OUTPUT_PER_MTOK=
